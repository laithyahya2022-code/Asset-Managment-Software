# ── Runtime ───────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000
API_PREFIX=api/v1
# Comma-separated allowed origins; unset = allow all (dev only!)
#CORS_ORIGINS=https://app.example.com

# ── Database ──────────────────────────────────────────────────────────
# postgres (production) | sqljs (in-memory demo/tests)
DB_TYPE=postgres
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=itam
DB_PASSWORD=itam
DB_NAME=itam
# Schema sync is for development only — use migrations in production.
DB_SYNCHRONIZE=true
DB_LOGGING=false
DB_SSL=false

# ── Auth (GENERATE STRONG RANDOM SECRETS FOR PRODUCTION) ─────────────
JWT_SECRET=change-me-in-production
JWT_REFRESH_SECRET=change-me-too-in-production
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
BCRYPT_ROUNDS=10

# ── Rate limiting ─────────────────────────────────────────────────────
THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=120
